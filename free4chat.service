[Unit]
Description=Free4Chat Self-Hosted Single VPS Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/free4chat/app
EnvironmentFile=-/opt/free4chat/.env
Environment=NODE_ENV=production
Environment=CI=true
Environment=PERSIST_DIR=/opt/free4chat/data
Environment=PORT=3000
Environment=IP=0.0.0.0
Environment=TURNSTILE_DISABLED=true
Environment=ALLOW_ANY_ORIGIN=true
Environment=ALLOW_ANY_HOST=true
Environment=SFU_MOCK_ENABLED=true
ExecStart=/usr/bin/npx wrangler dev --ip 0.0.0.0 --port 3000 --persist-to /opt/free4chat/data --show-interactive-dev-session false
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
