# ==============================================================================
# Free4Chat 单 VPS 自建部署环境变量配置文件 (Single VPS Environment Config)
# ==============================================================================
# 使用方法：
# cp .env.example .env
# 按需修改配置后启动服务：docker compose up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务配置 (Basic Server Settings)
# ------------------------------------------------------------------------------
# 容器内监听端口 (Default: 3000)
PORT=3000
IP=0.0.0.0

# 外部访问的完整 URL (建议配置，用于生成房间邀请链接和 Agent 引导链接)
# 示例: http://123.45.67.89:3000 或 https://chat.yourdomain.com
APP_URL=http://localhost:3000

# 自定义域名（如果使用 Caddy 自动申请免费 SSL 证书，请填写你的域名）
# 示例: DOMAIN=chat.yourdomain.com
DOMAIN=localhost

# 数据持久化目录（挂载容器内的 Durable Object SQLite 存储与 KV 数据）
PERSIST_DIR=/data

# ------------------------------------------------------------------------------
# 2. 安全与访问限制配置 (Access & Security Settings)
# ------------------------------------------------------------------------------
# 是否禁用 Cloudflare Turnstile 人机验证 (单 VPS 部署推荐保持 true，无需配置 Captcha)
TURNSTILE_DISABLED=true

# 是否允许任意来源请求 (自建部署推荐 true；若设为 false，请在 ALLOWED_ORIGINS 中列出允许的域名)
ALLOW_ANY_ORIGIN=true

# 允许的 Origin 列表（当 ALLOW_ANY_ORIGIN=false 时生效，逗号分隔）
# ALLOWED_ORIGINS=https://chat.yourdomain.com,http://localhost:3000

# 是否允许任意 Host 访问 MCP Agent 接口 (自建部署推荐 true)
ALLOW_ANY_HOST=true

# ------------------------------------------------------------------------------
# 3. WebRTC 实时音视频媒体配置 (WebRTC SFU Media Settings)
# ------------------------------------------------------------------------------
# 选项 A：模拟/离线模式 (默认推荐，零外部依赖)
# 当 SFU_APP_ID 为空时，服务会自动开启模拟 SFU 模式。
# 房间文字聊天、文件传输、AI Agent 协作、Task 任务、MCP 协议均可 100% 正常使用！
SFU_MOCK_ENABLED=true

# 选项 B：启用完整 WebRTC 实时语音与屏幕共享 (需免费 Cloudflare Calls 凭据)
# 前往 Cloudflare Dashboard -> Calls -> 创建应用获取（每月 10,000 分钟免费额度）：
# 配置后请将 SFU_MOCK_ENABLED 设为 false 或留空。
# SFU_APP_ID=your_cloudflare_realtime_sfu_app_id
# SFU_APP_SECRET=your_cloudflare_realtime_sfu_app_secret

# ------------------------------------------------------------------------------
# 4. 可选高级特性配置 (Advanced Features)
# ------------------------------------------------------------------------------
# 是否启用房间小程序/Mini-App 运行时支持 (Default: true)
ROOM_APPS_ENABLED=true

# 是否开启长轮询支持 (Default: false)
# MCP_LONGPOLL_ENABLED=false
